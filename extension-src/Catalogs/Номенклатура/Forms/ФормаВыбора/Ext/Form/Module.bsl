&НаСервере
&После("ПриСозданииНаСервере")
Процедура АО_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
	
	АО_ДобавитьРеквизитыОстатков();
	АО_ДобавитьПанельОстатков();
	АО_СостояниеОстатков = НСтр("ru = 'Выберите номенклатуру в списке.'");
	
КонецПроцедуры

&НаКлиенте
&После("ПриОткрытии")
Процедура АО_ПриОткрытииПосле(Отказ)
	
	ПодключитьОбработчикОжидания("АО_ОбновитьОстаткиПослеПаузы", 0.25, Истина);
	
КонецПроцедуры

&НаКлиенте
&После("СписокПриАктивизацииСтроки")
Процедура АО_СписокПриАктивизацииСтрокиПосле(Элемент)
	
	ПодключитьОбработчикОжидания("АО_ОбновитьОстаткиПослеПаузы", 0.25, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура АО_ОбновитьОстаткиПослеПаузы()
	
	ИмяСписка = ПодборТоваровКлиентСервер.ИмяСпискаНоменклатурыПоВариантуПоиска(ЭтаФорма);
	ЭлементСписка = Элементы.Найти(ИмяСписка);
	
	Если ЭлементСписка = Неопределено Или ЭлементСписка.ТекущиеДанные = Неопределено Тогда
		АО_ТекущаяНоменклатура = "";
		АО_ОчиститьОстаткиНаСервере(НСтр("ru = 'Выберите номенклатуру в списке.'"));
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ЭлементСписка.ТекущиеДанные;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		АО_ТекущаяНоменклатура = "";
		АО_ОчиститьОстаткиНаСервере(НСтр("ru = 'Выберите номенклатуру в списке.'"));
		Возврат;
	КонецЕсли;
	
	АО_ТекущаяНоменклатура = Строка(ТекущиеДанные.Ссылка);
	АО_СостояниеОстатков = НСтр("ru = 'Получение остатков...' ");
	АО_ОбновитьОстаткиНаСервере(ТекущиеДанные.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура АО_ОбновитьОстаткиНаСервере(Номенклатура)
	
	ТаблицаОстатков = АО_НоваяТаблицаОстатков();
	
	Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура")
		Или Не ЗначениеЗаполнено(Номенклатура)
		Или Номенклатура.ЭтоГруппа Тогда
		
		ЗначениеВРеквизитФормы(ТаблицаОстатков, "АО_ОстаткиПоСкладам");
		АО_СостояниеОстатков = НСтр("ru = 'Для группы остатки не рассчитываются.'");
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗапросСкладов = Новый Запрос;
		ЗапросСкладов.Текст =
			"ВЫБРАТЬ
			| Склады.Ссылка КАК Ссылка
			|ИЗ
			| Справочник.Склады КАК Склады
			|ГДЕ
			| НЕ Склады.ПометкаУдаления
			| И НЕ Склады.ЭтоГруппа";
		
		Склады = ЗапросСкладов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Если Склады.Количество() = 0 Тогда
			ЗначениеВРеквизитФормы(ТаблицаОстатков, "АО_ОстаткиПоСкладам");
			АО_СостояниеОстатков = НСтр("ru = 'В информационной базе нет доступных складов.'");
			Возврат;
		КонецЕсли;
		
		ИнформацияОТоваре = ПодборТоваровВызовСервера.ЦенаПродажиИОстаткиТовара(
			Номенклатура,
			Неопределено,
			Справочники.СоглашенияСКлиентами.ПустаяСсылка(),
			Справочники.Валюты.ПустаяСсылка(),
			Склады,
			Новый Массив);
		
		Для Каждого ТекущийОстаток Из ИнформацияОТоваре.ТекущиеОстатки Цикл
			Если ТекущийОстаток.Запас = 0 И ТекущийОстаток.Свободно = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаСклада = ТаблицаОстатков.Добавить();
			СтрокаСклада.Склад = ТекущийОстаток.Склад;
			СтрокаСклада.Запас = ТекущийОстаток.Запас;
			СтрокаСклада.Доступно = ТекущийОстаток.Свободно;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ТаблицаОстатков, "АО_ОстаткиПоСкладам");
		АО_СостояниеОстатков = ?(
			ТаблицаОстатков.Количество() = 0,
			НСтр("ru = 'Остатков нет.'"),
			"");
		
	Исключение
		ЗначениеВРеквизитФормы(ТаблицаОстатков, "АО_ОстаткиПоСкладам");
		АО_СостояниеОстатков = НСтр("ru = 'Не удалось получить остатки: '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура АО_ОчиститьОстаткиНаСервере(ТекстСостояния)
	
	ЗначениеВРеквизитФормы(АО_НоваяТаблицаОстатков(), "АО_ОстаткиПоСкладам");
	АО_СостояниеОстатков = ТекстСостояния;
	
КонецПроцедуры

&НаСервере
Процедура АО_ДобавитьРеквизитыОстатков()
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АО_ОстаткиПоСкладам", Новый ОписаниеТипов("ТаблицаЗначений")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"), "АО_ОстаткиПоСкладам"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"Запас", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)), "АО_ОстаткиПоСкладам"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"Доступно", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)), "АО_ОстаткиПоСкладам"));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АО_ТекущаяНоменклатура", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200))));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(
		"АО_СостояниеОстатков", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500))));
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура АО_ДобавитьПанельОстатков()
	
	ГруппаОстатков = Элементы.Добавить(
		"АО_ГруппаОстатковПоСкладам", Тип("ГруппаФормы"));
	ГруппаОстатков.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаОстатков.Заголовок = НСтр("ru = 'Остатки на складах'");
	ГруппаОстатков.ОтображатьЗаголовок = Истина;
	ГруппаОстатков.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ГруппаОстатков.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаОстатков.РастягиватьПоВертикали = Ложь;
	ГруппаОстатков.РастягиватьПоГоризонтали = Истина;
	
	ПолеНоменклатуры = Элементы.Добавить(
		"АО_ПолеТекущаяНоменклатура", Тип("ПолеФормы"), ГруппаОстатков);
	ПолеНоменклатуры.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеНоменклатуры.ПутьКДанным = "АО_ТекущаяНоменклатура";
	ПолеНоменклатуры.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеНоменклатуры.РастягиватьПоГоризонтали = Истина;
	
	ТаблицаОстатков = Элементы.Добавить(
		"АО_ОстаткиПоСкладам", Тип("ТаблицаФормы"), ГруппаОстатков);
	ТаблицаОстатков.ПутьКДанным = "АО_ОстаткиПоСкладам";
	ТаблицаОстатков.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	ТаблицаОстатков.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ТаблицаОстатков.ИзменятьСоставСтрок = Ложь;
	ТаблицаОстатков.ИзменятьПорядокСтрок = Ложь;
	ТаблицаОстатков.ТолькоПросмотр = Истина;
	ТаблицаОстатков.РастягиватьПоГоризонтали = Истина;
	ТаблицаОстатков.РастягиватьПоВертикали = Ложь;
	ТаблицаОстатков.Высота = 8;
	
	АО_ДобавитьКолонкуОстатков(ТаблицаОстатков, "Склад", НСтр("ru = 'Склад'"), 40);
	АО_ДобавитьКолонкуОстатков(ТаблицаОстатков, "Запас", НСтр("ru = 'В наличии'"), 12);
	АО_ДобавитьКолонкуОстатков(ТаблицаОстатков, "Доступно", НСтр("ru = 'Доступно'"), 12);
	
	ПолеСостояния = Элементы.Добавить(
		"АО_ПолеСостояниеОстатков", Тип("ПолеФормы"), ГруппаОстатков);
	ПолеСостояния.Вид = ВидПоляФормы.ПолеНадписи;
	ПолеСостояния.ПутьКДанным = "АО_СостояниеОстатков";
	ПолеСостояния.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ПолеСостояния.РастягиватьПоГоризонтали = Истина;
	
КонецПроцедуры

&НаСервере
Процедура АО_ДобавитьКолонкуОстатков(ТаблицаОстатков, ИмяКолонки, Заголовок, Ширина)
	
	ПолеКолонки = Элементы.Добавить(
		"АО_ОстаткиПоСкладам" + ИмяКолонки, Тип("ПолеФормы"), ТаблицаОстатков);
	ПолеКолонки.Вид = ВидПоляФормы.ПолеВвода;
	ПолеКолонки.ПутьКДанным = "АО_ОстаткиПоСкладам." + ИмяКолонки;
	ПолеКолонки.Заголовок = Заголовок;
	ПолеКолонки.ТолькоПросмотр = Истина;
	ПолеКолонки.Ширина = Ширина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция АО_НоваяТаблицаОстатков()
	
	ТаблицаОстатков = Новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
	ТаблицаОстатков.Колонки.Добавить("Запас", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	ТаблицаОстатков.Колонки.Добавить("Доступно", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
	
	Возврат ТаблицаОстатков;
	
КонецФункции
